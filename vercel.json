{
  "$schema": "https://vercel.sh",
  "crons": [
    {
      "path": "/api/scraper/sync-all",
      "schedule": "0 4 * * *"
    }
  ],
  "services": {
    "backend": {
      "root": "backend",
      "framework": "nestjs"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
