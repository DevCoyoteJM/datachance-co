{
  "$schema": "https://vercel.sh",
  "crons": [
    {
      "path": "/api/scraper/sync-daily",
      "schedule": "0 4 * * *"
    }
  ],
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "dist/bundle.js",
      "installCommand": "npm install",
      "buildCommand": "npx prisma generate && npm run build",
      "includeFiles": "node_modules/.prisma/**"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
