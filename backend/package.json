{
  "name": "datachance-backend",
  "version": "1.0.0",
  "description": "DataChance CO Backend - NestJS with Prisma and SQLite",
  "author": "DataChance Team",
  "private": true,
  "main": "dist/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "copy:engine": "node -e \"const fs = require('fs'), path = require('path'), s = path.join('node_modules', '.prisma', 'client'); if (fs.existsSync(s)) for (const f of fs.readdirSync(s)) if (f.endsWith('.node')) fs.copyFileSync(path.join(s, f), path.join('dist', f));\"",
    "build": "nest build && esbuild dist/main.js --bundle --platform=node --target=node20 --outfile=dist/bundle.js --external:@prisma/client --external:.prisma/client --external:class-transformer/storage --external:@nestjs/microservices --external:@nestjs/websockets",
    "vercel-build": "nest build && esbuild dist/main.js --bundle --platform=node --target=node20 --outfile=dist/bundle.js --external:@prisma/client --external:.prisma/client --external:class-transformer/storage --external:@nestjs/microservices --external:@nestjs/websockets",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^6.4.1",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "prisma": "^6.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
