generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Lottery {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  category  String   // "LOTERIA" | "CHANCE" | "ESPECIAL" | "BALOTO"
  schedule  String   // "Mañana" | "Tarde" | "Noche" | "22:30"
  playDays  String   // "Diario", "Lunes", "Miércoles y Sábados", etc.
  hasSeries Boolean  @default(false)
  hasZodiac Boolean  @default(false)
  isBaloto  Boolean  @default(false)
  results   Result[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Result {
  id          Int      @id @default(autoincrement())
  lotteryId   Int
  lottery     Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  number      String?  // 4 dígitos ej: "0492"
  series      String?  // 3 dígitos ej: "128"
  zodiacSign  String?  // ej: "Tauro"
  balotas     String?  // ej: "04-12-23-35-42"
  superbalota String?  // ej: "08"
  jackpot     String?  // ej: "$ 17.500 Millones"
  drawDate    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lotteryId])
  @@index([drawDate])
}
